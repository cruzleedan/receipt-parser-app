# OCR Configuration
OCR_USE_GPU=false
OCR_LANG=en
OCR_DET_THRESH=0.3
OCR_DET_BOX_THRESH=0.5
OCR_REC_BATCH_NUM=6
OCR_USE_ANGLE_CLS=true
OCR_SHOW_LOG=false

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=30
OLLAMA_TEMPERATURE=0.0
OLLAMA_TOP_P=0.9
OLLAMA_NUM_PREDICT=512

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Performance Settings
BATCH_MAX_SIZE=10
MAX_IMAGE_SIZE=4096
ENABLE_CACHE=false

# Paths
RECEIPTS_DIR=/app/receipts
OUTPUT_DIR=/app/output
